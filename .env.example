# Copy to .env and fill in. This file is the committed template; .env is ignored.
#   cp .env.example .env     (PowerShell: Copy-Item .env.example .env)

# Phase 5 generation LLM. Required for answering, NOT for embedding — Phase 3
# embeds locally with all-MiniLM-L6-v2 and needs no API key.
#
# If GROQ_API_KEY is absent the app must still start and must still answer from
# the index in retrieval-only mode, rather than failing at import time.
#
# MODEL NOTE: llama-3.1-8b-instant is deprecated on Groq and now returns
#   HTTP 404 model_not_found for most keys. The models still served are listed by
#   GET https://api.groq.com/openai/v1/models. openai/gpt-oss-20b is the default
#   here: it is the fastest of the instruction-following models available and it
#   holds the strict 3-sentence / one-chunk_id output contract reliably.
#   openai/gpt-oss-120b and qwen/qwen3.8-27b also work; the engine is not
#   model-specific, so changing this value is the only edit required.
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
GROQ_MODEL=openai/gpt-oss-20b
