# Streamlit secrets, for a checkout that keeps credentials in the Streamlit
# convention instead of a .env file. Copy to secrets.toml and fill in:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is gitignored. This example is not, and holds no real value.
#
# ---------------------------------------------------------------------------
# WHICH FILE SHOULD I USE?
# ---------------------------------------------------------------------------
# src/vector_store.py:load_credentials() resolves in this order, and reports
# which one answered (run `python -m src.vector_store` to see it):
#
#   1. st.secrets          <- this file
#   2. the environment     <- a real exported variable, AND anything .env loads
#   3. nothing             <- reported, not raised; the app still answers from
#                             the index without a generator
#
# On Streamlit Community Cloud you do not need this file. The dashboard does
# not write a secrets.toml - it injects the value as an environment variable,
# and Streamlit 1.42.2's st.secrets does not read the environment. So Community
# Cloud secrets arrive through tier 2, and they beat a local .env, which is what
# stops a developer's key from shadowing the deployed one.
#
# Use this file when you run `streamlit run` yourself and prefer the Streamlit
# convention. Use .env for the same thing. Both work; the code does not care.
#
# ---------------------------------------------------------------------------
# THE TWO REQUIRED KEYS - exactly these names, no others
# ---------------------------------------------------------------------------
#   GROQ_API_KEY   your Groq key, console.groq.com/keys. Starts with "gsk_".
#   GROQ_MODEL     the generator to call. Must match .env.example.
#
# These two are the whole contract - src/vector_store.py:CREDENTIAL_VARS is
# exactly this tuple, so nothing else in this file is read.
#
# BOTH are required. A key without GROQ_MODEL is not a usable credential: the
# engine reports "no_key" with detail GROQ_MODEL and silently drops to the
# extractive path, which still answers correctly, so it looks like the LLM is
# simply not being used rather than like a misconfiguration.
#
# ---------------------------------------------------------------------------
# NEVER PUT A REAL KEY IN THIS FILE
# ---------------------------------------------------------------------------
# This file is TRACKED BY GIT - that is the difference between it and
# secrets.toml, which is gitignored. A real key pasted here gets published to
# the remote, and deleting it afterwards does not un-publish it. Anyone with
# read access can then spend your quota.
#
# If you want this key on the deployed app, set it in the Streamlit Community
# Cloud dashboard under Settings -> Secrets, not in a file. That is the intended
# route and it needs no file in the repo at all.
#
# For local use, put the real value in the copy, not here:
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml

GROQ_API_KEY = "gsk_REPLACE_WITH_YOUR_GROQ_KEY"

# Must match .env.example. The test suite asserts that all three committed
# templates (.env, .env.example, this file) name the same model, so a rename in
# one and not the others fails the build instead of quietly running a different
# generator than the tests were tuned against.
GROQ_MODEL = "openai/gpt-oss-20b"
